
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#070d1c">
<meta name="description" content="Youcef Abou Youcef — Founder, innovator and creator. Explore GeoPrecision Studio, LuNou, Neurova, Sol-Shoe, BrandCraft and Startup Vibes.">
<title>Youcef Abou Youcef | Digital Universe</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Outfit:wght@400;500;600;700;800;900&family=Cairo:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

<style>
:root{
  --bg:#070d1c;
  --panel:#101a2d;
  --line:rgba(255,255,255,.12);
  --text:#f4f7ff;
  --muted:#9daac0;
  --cyan:#5de3ff;
  --gold:#f1c57c;
  --green:#58ddb4;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0;
  background:var(--bg);
  color:var(--text);
  font-family:"DM Sans",sans-serif;
  overflow-x:hidden;
}
body[dir=rtl]{font-family:Cairo,sans-serif}
a{color:inherit;text-decoration:none}
button{font:inherit;cursor:pointer}
button:focus-visible,a:focus-visible{
  outline:2px solid var(--cyan);
  outline-offset:4px;
}
::selection{background:#55d8ff;color:#06101c}
.container{width:min(1160px,calc(100% - 40px));margin:auto}
.background{
  position:fixed;inset:0;z-index:-2;
  background:
    radial-gradient(ellipse at 78% 8%,#17335c 0%,transparent 45%),
    radial-gradient(ellipse at 5% 75%,#123638 0%,transparent 40%),
    #070d1c;
}
.background:after{
  content:"";position:absolute;inset:0;
  background-image:linear-gradient(#ffffff07 1px,transparent 1px),
  linear-gradient(90deg,#ffffff07 1px,transparent 1px);
  background-size:55px 55px;
  mask-image:linear-gradient(#0008,transparent 85%);
}
.orb{
  position:fixed;width:400px;height:400px;border-radius:50%;
  filter:blur(105px);opacity:.15;pointer-events:none;z-index:-1;
  background:#28c8e9;left:-180px;top:35%;
  animation:drift 13s ease-in-out infinite alternate;
}
@keyframes drift{to{transform:translate(120px,-100px)}}

/* Navigation */
header{
  position:sticky;top:0;z-index:50;
  background:#080f20cc;
  backdrop-filter:blur(22px);
  border-bottom:1px solid var(--line);
}
.nav{
  display:flex;align-items:center;justify-content:space-between;
  min-height:76px;gap:18px;
}
.brand{
  display:flex;align-items:center;gap:12px;
  font-family:Outfit,sans-serif;font-weight:800;font-size:17px;
}
.brand-mark{
  display:grid;place-items:center;
  width:43px;height:43px;border-radius:14px;
  background:linear-gradient(140deg,#58e1ff,#7564e9);
  color:#061020;font-size:19px;font-weight:900;
  box-shadow:0 0 25px #58e1ff35;
}
.navlinks{display:flex;align-items:center;gap:25px}
.navlinks a{font-size:13px;color:#b5c1d3;transition:.3s}
.navlinks a:hover{color:white}
.lang{
  background:#ffffff0c;border:1px solid var(--line);
  color:white;padding:10px;border-radius:12px;
}
.contact-nav{
  background:white!important;color:#091124!important;
  padding:12px 18px;border-radius:30px;font-weight:800;
}

/* Hero */
.hero{
  position:relative;
  min-height:670px;
  display:grid;grid-template-columns:1.08fr .92fr;
  align-items:center;gap:50px;padding:90px 0 80px;
}
.eyebrow{
  display:inline-flex;align-items:center;gap:10px;
  color:var(--cyan);font-size:11px;font-weight:800;
  letter-spacing:2px;text-transform:uppercase;
}
.eyebrow:before{
  content:"";width:7px;height:7px;border-radius:50%;
  background:#62e5b0;box-shadow:0 0 12px #62e5b0;
}
.hero h1{
  font-family:Outfit,sans-serif;
  font-size:clamp(48px,6.4vw,88px);
  letter-spacing:-4px;line-height:1.02;
  margin:25px 0;
}
body[dir=rtl] .hero h1{font-family:Cairo;letter-spacing:-2px}
.gradient-text{
  background:linear-gradient(110deg,#fff,#6fe0ff 45%,#a6a4ff);
  -webkit-background-clip:text;background-clip:text;
  color:transparent;
}
.hero p{
  color:var(--muted);font-size:16px;
  line-height:1.95;max-width:510px;
}
.hero-buttons{display:flex;gap:12px;flex-wrap:wrap;margin-top:30px}
.btn{
  display:inline-flex;align-items:center;justify-content:center;
  gap:12px;border-radius:14px;padding:16px 23px;
  font-size:13px;font-weight:800;transition:.3s;
}
.btn:hover{transform:translateY(-4px)}
.primary{
  background:linear-gradient(110deg,#6fe4ff,#7ba5ff);
  color:#07101e;box-shadow:0 12px 35px #42caff25;
}
.secondary{border:1px solid #ffffff35;background:#ffffff08}
.hero-note{
  display:flex;align-items:center;gap:12px;
  margin-top:35px;color:#aab6c9;font-size:12px;
}
.hero-note span{width:30px;height:1px;background:var(--gold)}

/* 3D visual */
.hero-art{
  position:relative;height:480px;
  display:flex;align-items:center;justify-content:center;
  perspective:900px;
}
.art-ring{
  position:absolute;width:390px;height:390px;
  border:1px solid #73dfff36;border-radius:50%;
  transform:rotateX(67deg) rotateZ(-30deg);
  box-shadow:0 0 65px #52d4ff12;
}
.art-ring.two{width:300px;height:300px;transform:rotateX(60deg) rotateZ(40deg)}
.art-ring.three{width:455px;height:455px;border-style:dashed;opacity:.4}
.core{
  position:relative;width:265px;height:265px;
  transform-style:preserve-3d;
  animation:float 6s ease-in-out infinite;
}
@keyframes float{
  0%,100%{transform:translateY(0) rotate(-9deg)}
  50%{transform:translateY(-18px) rotate(3deg)}
}
.core-face{
  position:absolute;inset:0;border-radius:35px;
  display:flex;flex-direction:column;
  align-items:center;justify-content:center;gap:14px;
  background:linear-gradient(145deg,#223e62,#101a32 65%,#0d1830);
  border:1px solid #a3edff55;
  box-shadow:25px 30px 75px #0009,inset 0 1px 35px #ffffff13,0 0 65px #3ecfff24;
  transform:rotateX(8deg) rotateY(-14deg);
}
.core-face:before{
  content:"";position:absolute;inset:13px;
  border:1px solid #ffffff18;border-radius:26px;
}
.core-symbol{
  font:900 96px Outfit,sans-serif;
  background:linear-gradient(130deg,#fff,#4ad9fa,#a9a6ff);
  -webkit-background-clip:text;background-clip:text;color:transparent;
}
.core-caption{font-size:10px;letter-spacing:3px;color:#a3c8e6}
.satellite{
  position:absolute;padding:12px 15px;border-radius:13px;
  border:1px solid #ffffff28;
  background:#111e33dc;backdrop-filter:blur(10px);
  box-shadow:0 12px 30px #0006;
  font-size:11px;font-weight:800;
  animation:float 7s ease-in-out infinite;
}
.s1{top:45px;left:0;color:#67e2ff}
.s2{right:-5px;top:130px;color:#f3c581;animation-delay:-2s}
.s3{bottom:40px;left:25px;color:#76e2b6;animation-delay:-3s}
.s4{bottom:75px;right:-5px;color:#b6a4ff;animation-delay:-1s}

/* Shared sections */
section{scroll-margin-top:90px}
.section-head{margin-bottom:32px}
.section-kicker{
  color:var(--cyan);font-size:11px;
  letter-spacing:2.5px;font-weight:800;text-transform:uppercase;
}
.section-head h2{
  font:800 clamp(32px,4vw,48px) Outfit,sans-serif;
  letter-spacing:-1.5px;margin:12px 0;
}
body[dir=rtl] .section-head h2{font-family:Cairo}
.section-head p{color:var(--muted);line-height:1.8;font-size:14px}
.ventures{padding:65px 0}
.venture-grid{
  display:grid;grid-template-columns:repeat(3,1fr);gap:18px;
}
.venture{
  position:relative;min-height:300px;overflow:hidden;
  padding:27px;border:1px solid var(--line);
  border-radius:24px;background:linear-gradient(145deg,#15243c,#0b1324);
  transition:transform .35s,border-color .35s,box-shadow .35s;
  display:flex;flex-direction:column;
}
.venture:hover{
  transform:translateY(-8px);
  border-color:#ffffff55;
  box-shadow:0 25px 50px #0007;
}
.venture:before{
  content:"";position:absolute;width:220px;height:220px;
  border-radius:50%;right:-90px;top:-100px;
  background:var(--accent);filter:blur(70px);opacity:.19;
}
.venture-number{
  color:#ffffff60;font-size:11px;letter-spacing:2px;
}
.venture-icon{
  width:76px;height:76px;display:grid;place-items:center;
  margin:26px 0 20px;
  border:1px solid #ffffff26;border-radius:21px;
  background:#ffffff0b;color:var(--accent);
  font:900 29px Outfit,sans-serif;
  box-shadow:inset 0 0 20px #ffffff08;
}
.venture-icon img{
  width:100%;height:100%;object-fit:contain;
  border-radius:17px;padding:5px;
}
.venture h3{font:800 23px Outfit,sans-serif;margin:0 0 9px}
.venture p{color:#aebbd0;font-size:13px;line-height:1.7;margin:0}
.venture-footer{
  display:flex;justify-content:space-between;align-items:center;
  margin-top:auto;padding-top:24px;
  color:var(--accent);font-size:11px;font-weight:800;
  letter-spacing:.5px;
}
.arrow{
  width:32px;height:32px;border-radius:50%;
  border:1px solid #ffffff35;display:grid;place-items:center;
  font-size:17px;
}
.featured{grid-column:span 2;min-height:330px}
.featured .venture-icon{width:90px;height:90px}
.featured h3{font-size:30px}
.featured:after{
  content:"";position:absolute;right:-65px;bottom:-160px;
  width:340px;height:340px;border-radius:50%;
  border:35px solid #ffffff07;
  box-shadow:0 0 0 38px #ffffff04,0 0 0 85px #ffffff03;
  pointer-events:none;
}

/* Expertise */
.expertise{padding:75px 0}
.expertise-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.expertise-item{
  background:#ffffff06;border:1px solid var(--line);
  border-radius:19px;padding:26px 20px;
}
.expertise-item .emoji{font-size:26px;margin-bottom:20px}
.expertise-item h3{font-size:15px;margin:0 0 9px}
.expertise-item p{color:var(--muted);font-size:12px;line-height:1.8}

/* About */
.about{padding:60px 0}
.about-panel{
  border:1px solid #ffffff22;border-radius:28px;
  padding:55px;
  background:
    radial-gradient(circle at 90% 10%,#2c7d9d36,transparent 40%),
    linear-gradient(135deg,#15233d,#0c1426);
  display:grid;grid-template-columns:1fr 1fr;gap:50px;align-items:center;
}
.about-monogram{
  width:210px;height:210px;border-radius:50%;
  margin:auto;display:grid;place-items:center;
  border:1px solid #70e2ff55;
  box-shadow:0 0 0 20px #ffffff05,0 0 0 45px #ffffff03,0 0 90px #4bd5ff21;
  background:linear-gradient(145deg,#243a5c,#091426);
  font:900 90px Outfit,sans-serif;color:#8be9ff;
}
.about-copy h2{font:800 38px Outfit,sans-serif;margin:15px 0}
.about-copy p{font-size:14px;color:#b1bed0;line-height:1.9}
.tags{display:flex;gap:9px;flex-wrap:wrap;margin-top:20px}
.tags span{
  padding:9px 13px;border-radius:30px;
  background:#ffffff0c;border:1px solid #ffffff19;
  font-size:11px;color:#d3dfed;
}

/* Contact */
.contact{padding:80px 0 55px}
.contact-panel{
  text-align:center;border:1px solid #ffffff25;
  border-radius:28px;padding:55px 25px;
  background:radial-gradient(ellipse at 50% 0%,#214568,transparent 65%),#0e182a;
}
.contact-panel h2{
  font:800 clamp(32px,5vw,58px) Outfit,sans-serif;
  margin:16px 0;
}
.contact-panel p{color:var(--muted);font-size:14px}
.social-grid{
  display:grid;grid-template-columns:repeat(4,1fr);
  gap:12px;margin:35px auto 0;max-width:780px;
}
.social{
  display:flex;align-items:center;justify-content:center;gap:10px;
  padding:16px 12px;border:1px solid #ffffff25;
  border-radius:13px;background:#ffffff09;
  font-size:12px;font-weight:800;transition:.3s;
}
.social:hover{background:#ffffff20;transform:translateY(-4px)}
.email-link{
  display:inline-block;margin-top:27px;color:#8bdfff;
  font-size:13px;overflow-wrap:anywhere;
}
footer{
  padding:30px 0;border-top:1px solid var(--line);
  color:#8796ac;font-size:11px;
}
.footer-inner{display:flex;justify-content:space-between;gap:15px}
.reveal{
  opacity:0;transform:translateY(30px);
  transition:opacity .7s,transform .7s;
}
.reveal.visible{opacity:1;transform:translateY(0)}
@media(max-width:850px){
  .navlinks a:not(.contact-nav){display:none}
  .hero{grid-template-columns:1fr;padding:65px 0 35px;gap:0}
  .hero-art{height:380px}
  .art-ring{width:300px;height:300px}
  .art-ring.two{width:230px;height:230px}
  .art-ring.three{width:350px;height:350px}
  .core{width:210px;height:210px}
  .core-symbol{font-size:75px}
  .venture-grid{grid-template-columns:repeat(2,1fr)}
  .expertise-grid{grid-template-columns:repeat(2,1fr)}
}
@media(max-width:550px){
  .container{width:calc(100% - 30px)}
  .brand{font-size:13px}
  .brand-mark{width:38px;height:38px}
  .nav{min-height:66px}
  .navlinks{gap:8px}
  .contact-nav{padding:10px!important;font-size:11px!important}
  .hero h1{font-size:clamp(42px,11vw,62px);letter-spacing:-2px}
  .hero p{font-size:14px}
  .hero-art{height:330px}
  .core{width:175px;height:175px}
  .core-symbol{font-size:63px}
  .core-caption{font-size:8px}
  .art-ring{width:260px;height:260px}
  .art-ring.two{width:200px;height:200px}
  .art-ring.three{width:310px;height:310px}
  .satellite{font-size:9px;padding:9px}
  .s1{left:5px}.s2{right:0}.s3{left:5px}.s4{right:5px}
  .venture-grid{grid-template-columns:1fr}
  .featured{grid-column:span 1}
  .venture{min-height:275px}
  .expertise-grid{grid-template-columns:repeat(2,1fr);gap:10px}
  .expertise-item{padding:20px 14px}
  .about-panel{grid-template-columns:1fr;padding:35px 24px}
  .about-monogram{width:150px;height:150px;font-size:65px}
  .social-grid{grid-template-columns:repeat(2,1fr)}
  .footer-inner{flex-direction:column;text-align:center}
}
@media(prefers-reduced-motion:reduce){
  *,*:before,*:after{
    animation-duration:.01ms!important;
    transition-duration:.01ms!important;
    scroll-behavior:auto!important;
  }
  .reveal{opacity:1;transform:none}
}
</style>
</head>

<body>
<div class="background"></div>
<div class="orb"></div>

<header>
  <div class="container nav">
    <a class="brand" href="#home">
      <span class="brand-mark">Y.</span>
      <span>YOUCEF <span style="color:#65dfff">/</span> DIGITAL</span>
    </a>
    <nav class="navlinks">
      <a href="#ventures" data-i18n="navVentures">Ventures</a>
      <a href="#expertise" data-i18n="navExpertise">Expertise</a>
      <a href="#about" data-i18n="navAbout">About</a>
      <button class="lang" id="langBtn" aria-label="Change language">EN ▾</button>
      <a class="contact-nav" href="#contact" data-i18n="navContact">Connect ↗</a>
    </nav>
  </div>
</header>

<main>
<section class="container hero" id="home">
  <div class="hero-copy">
    <div class="eyebrow" data-i18n="eyebrow">Founder • Creator • Innovator</div>
    <h1>
      <span data-i18n="hero1">One vision.</span><br>
      <span class="gradient-text" data-i18n="hero2">Infinite possibilities.</span>
    </h1>
    <p data-i18n="heroDesc">
      I'm Youcef Abou Youcef. I build at the intersection of technology,
      geospatial intelligence, creative design and human-centered innovation.
      Welcome to my digital universe.
    </p>
    <div class="hero-buttons">
      <a href="#ventures" class="btn primary">
        <span data-i18n="explore">Explore my ventures</span> ↗
      </a>
      <a href="https://wa.me/qr/YPARMFRLV4IAD1"
         target="_blank" rel="noopener noreferrer"
         class="btn secondary">
        <span data-i18n="collaborate">Let's collaborate</span> ↗
      </a>
    </div>
    <div class="hero-note">
      <span></span>
      <span data-i18n="based">Based in Algeria · Creating beyond borders</span>
    </div>
  </div>

  <div class="hero-art" aria-label="Interactive-inspired digital universe illustration">
    <div class="art-ring three"></div>
    <div class="art-ring"></div>
    <div class="art-ring two"></div>
    <div class="core">
      <div class="core-face">
        <div class="core-symbol">Y.</div>
        <div class="core-caption">DIGITAL UNIVERSE</div>
      </div>
    </div>
    <div class="satellite s1">◈ GEO INTELLIGENCE</div>
    <div class="satellite s2">✦ CREATIVE STUDIO</div>
    <div class="satellite s3">◎ AI INNOVATION</div>
    <div class="satellite s4">◇ HUMAN IMPACT</div>
  </div>
</section>

<section class="ventures container" id="ventures">
  <div class="section-head reveal">
    <div class="section-kicker">01 / THE ECOSYSTEM</div>
    <h2 data-i18n="venturesTitle">Ideas turned into ventures.</h2>
    <p data-i18n="venturesDesc">
      Six distinct initiatives. One ambition: meaningful impact through technology and creativity.
    </p>
  </div>

  <div class="venture-grid">

    <a class="venture featured reveal"
       style="--accent:#5ce2ba"
       href="https://www.instagram.com/geoprecision_studio/"
       target="_blank" rel="noopener noreferrer">
      <span class="venture-number">01 / GEOSPATIAL TECHNOLOGY</span>
      <div class="venture-icon">
        <img src="geoprecision.png" alt="GeoPrecision Studio logo"
             onerror="this.style.display='none';this.parentNode.append('G')">
      </div>
      <h3>GeoPrecision Studio</h3>
      <p data-i18n="geoDesc">
        Scientific GIS, cartography, spatial analysis, remote sensing
        and research-ready geographic solutions.
      </p>
      <div class="venture-footer">
        <span>GIS • CARTOGRAPHY • RESEARCH</span>
        <span class="arrow">↗</span>
      </div>
    </a>

    <a class="venture reveal" style="--accent:#ff926b"
       href="https://www.instagram.com/lunou_vision/"
       target="_blank" rel="noopener noreferrer">
      <span class="venture-number">02 / ASSISTIVE TECHNOLOGY</span>
      <div class="venture-icon">
        <img src="lunou.png" alt="LuNou logo"
             onerror="this.style.display='none';this.parentNode.append('LN')">
      </div>
      <h3>LuNou</h3>
      <p data-i18n="lunouDesc">
        Smart glasses concept designed to support navigation and independence
        for blind and visually impaired people.
      </p>
      <div class="venture-footer">
        <span>SMART VISION</span><span class="arrow">↗</span>
      </div>
    </a>

    <article class="venture reveal" style="--accent:#54baff">
      <span class="venture-number">03 / MEDICAL AI</span>
      <div class="venture-icon">
        <img src="neurova.png" alt="Neurova logo"
             onerror="this.style.display='none';this.parentNode.append('N')">
      </div>
      <h3>Neurova</h3>
      <p data-i18n="neuroDesc">
        Research-driven AI concepts for medical image analysis
        and intelligent clinical decision support.
      </p>
      <div class="venture-footer">
        <span>AI • HEALTHCARE</span><span class="arrow">✧</span>
      </div>
    </article>

    <article class="venture reveal" style="--accent:#f3a1a1">
      <span class="venture-number">04 / WEARABLE INNOVATION</span>
      <div class="venture-icon">
        <img src="solshoe.png" alt="Sol-Shoe logo"
             onerror="this.style.display='none';this.parentNode.append('S')">
      </div>
      <h3>Sol-Shoe</h3>
      <p data-i18n="solDesc">
        Patented smart assistive footwear concept integrating sensing,
        guidance and connected technology.
      </p>
      <div class="venture-footer">
        <span>SMART FOOTWEAR</span><span class="arrow">✧</span>
      </div>
    </article>

    <a class="venture reveal" style="--accent:#f5ca71"
       href="https://www.instagram.com/brandcraft_01/"
       target="_blank" rel="noopener noreferrer">
      <span class="venture-number">05 / CREATIVE PRODUCTION</span>
      <div class="venture-icon">
        <img src="brandcraft.png" alt="BrandCraft logo"
             onerror="this.style.display='none';this.parentNode.append('BC')">
      </div>
      <h3>BrandCraft</h3>
      <p data-i18n="brandDesc">
        Brand identities, visual storytelling, motion design,
        digital experiences and promotional content.
      </p>
      <div class="venture-footer">
        <span>DESIGN • MOTION</span><span class="arrow">↗</span>
      </div>
    </a>

    <a class="venture reveal" style="--accent:#ff9c60"
       href="https://www.instagram.com/startup_vibes_/"
       target="_blank" rel="noopener noreferrer">
      <span class="venture-number">06 / CREATOR ECONOMY</span>
      <div class="venture-icon">
        <img src="startupvibes.png" alt="Startup Vibes logo"
             onerror="this.style.display='none';this.parentNode.append('SV')">
      </div>
      <h3>Startup Vibes</h3>
      <p data-i18n="startupDesc">
        Entrepreneurship, innovation stories, opportunities
